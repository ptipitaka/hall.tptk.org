# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/

# Django / Wagtail
media/
staticfiles/
*.log
local_settings.py

# Node / frontend
node_modules/
frontend/dist/
static/dist/
staticfiles/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.pid

# Scans / large binaries (never commit)
*.pdf
*.jpg
*.jpeg
*.tif
*.tiff
!static/branding/**

# Branding assets for SACRED site (committed)
!static/branding/*.png
!static/branding/*.webp

# Test / coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Scratch extract output (regenerate: python scripts/extract_catalog_volumes.py)
scripts/output/*
!scripts/output/.gitkeep

# CS Roman extract staging (regenerable); track volumes/<id>/data/ instead
books/cs-roman/output/*
!books/cs-roman/output/.gitkeep
books/cs-roman/source/*.pdf

# Vendored reference dump (local only; too large for the repo)
docs/tipitaka.app-main/

# CS Roman local DPD SQLite / archives (fetch via scripts/fetch_dpd_db.py)
books/cs-roman/vendor/dpd/

# CS Roman ad-hoc scratch (see scripts/scratch/README.md); keep archive + README
books/cs-roman/scripts/scratch/*
!books/cs-roman/scripts/scratch/README.md
!books/cs-roman/scripts/scratch/archive/
!books/cs-roman/scripts/scratch/archive/**

