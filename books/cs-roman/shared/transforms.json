{
  "schema_version": 2,
  "rules": [
    {
      "id": "roman-dighamaddhana-long-i",
      "when": {
        "match": "dighamaddhānaṃ"
      },
      "do": {
        "replace": {
          "with": "dīghamaddhānaṃ",
          "remark": "Roman dī- (long i); edition typo dighamaddhānaṃ in 01Vin01 p10, 07Di02 p102"
        }
      }
    },
    {
      "id": "roman-bahukaraniya-long-i",
      "when": {
        "match": "bahukaraṇiyā"
      },
      "do": {
        "replace": {
          "with": "bahukaraṇīyā",
          "remark": "Roman -ṇī- (long i); edition typo bahukaraṇiyā in 01Vin01 p54 (bahukaraṇīyā already attested)"
        }
      }
    },
    {
      "id": "roman-anadinavadasso-long-i",
      "when": {
        "match": "anādinavadasso"
      },
      "do": {
        "replace": {
          "with": "anādīnavadasso",
          "remark": "Roman -dī- (long i); edition typo anādinavadasso in 01Vin01 p21 (anādīnavadass- already attested)"
        }
      }
    },
    {
      "id": "roman-attiyamano-long-i",
      "when": {
        "match": "aṭṭiyamāno"
      },
      "do": {
        "replace": {
          "with": "aṭṭīyamāno",
          "remark": "Roman -ṭṭī- (long i); edition typo aṭṭiyamāno in 01Vin01 p30, 25Khu08 p247 (aṭṭīyamāno already attested, e.g. 01Vin01 p29)"
        }
      }
    },
    {
      "id": "roman-dukkatassati-long-a",
      "when": {
        "match": "dukkaṭassati"
      },
      "do": {
        "replace": {
          "with": "dukkaṭassāti",
          "remark": "Roman dukkaṭassa + iti (-ssā-); edition typo dukkaṭassati in 01Vin01 p74, p139 (dukkaṭassāti already attested)"
        }
      }
    },
    {
      "id": "roman-samika-long-a",
      "when": {
        "match": "samikā"
      },
      "do": {
        "replace": {
          "with": "sāmikā",
          "remark": "Roman sā- (long a); edition typo samikā in 01Vin01 p79 (sāmikā already attested, e.g. same formula p79 (94-97))"
        }
      }
    },
    {
      "id": "roman-assamanaka-long-a",
      "when": {
        "match": "assamaṇakaṃ"
      },
      "do": {
        "replace": {
          "with": "assāmaṇakaṃ",
          "remark": "Roman assā- (long a); edition typo assamaṇakaṃ in 01Vin01 p54 (assāmaṇakaṃ already attested, e.g. same formula p21)"
        }
      }
    },
    {
      "id": "roman-akaraniya-long-i",
      "when": {
        "match": "akaraṇiyaṃ"
      },
      "do": {
        "replace": {
          "with": "akaraṇīyaṃ",
          "remark": "Roman -ṇī- (long i); edition typo akaraṇiyaṃ in 01Vin01 p54 (akaraṇīyaṃ already attested, e.g. same formula p21)"
        }
      }
    },
    {
      "id": "roman-quote-iti-unbold",
      "when": {
        "match": "”ti",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 56,
            "order": 224
          },
          {
            "volume": "01Vin01",
            "page": 116,
            "order": 589
          },
          {
            "volume": "01Vin01",
            "page": 117,
            "order": 592
          }
        ]
      },
      "do": {
        "unbold": {
          "skip": 1,
          "remark": "Roman stroke includes closing iti after ”; 01Vin01 p56 order 224 item 91 (period already unbold; p25 §39 already split)"
        }
      }
    },
    {
      "id": "roman-bandhim-acc",
      "when": {
        "match": "bandhiṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 79
          }
        ]
      },
      "do": {
        "replace": {
          "with": "bandhaṃ",
          "remark": "Roman bandhaṃ (acc.); edition typo bandhiṃ in 01Vin01 p79. token skips bandhiṃsu / anubandhiṃ; volumes+pages skip aorist bandhiṃ (15An01 p526) and other books' p79"
        }
      }
    },
    {
      "id": "roman-kukuccam-geminate-kk",
      "when": {
        "match": "kukuccaṃ"
      },
      "do": {
        "replace": {
          "with": "kukkuccaṃ",
          "remark": "Roman geminate kk; edition typo kukuccaṃ in 01Vin01 (kukkuccaṃ already attested)"
        }
      }
    },
    {
      "id": "roman-kukuccayanta-geminate-kk",
      "when": {
        "match": "kukuccāyantā"
      },
      "do": {
        "replace": {
          "with": "kukkuccāyantā",
          "remark": "Roman geminate kk; edition typo kukuccāyantā in 01Vin01 p83"
        }
      }
    },
    {
      "id": "roman-sariputta-vipassi-space",
      "when": {
        "match": "SāriputtaVipassī"
      },
      "do": {
        "replace": {
          "with": "Sāriputta Vipassī",
          "remark": "Roman glue between vocative Sāriputta and Vipassī"
        }
      }
    },
    {
      "id": "roman-sa-upadanaya-linewrap",
      "when": {
        "match": "sa- upādānāya"
      },
      "do": {
        "replace": {
          "with": "saupādānāya",
          "remark": "Roman line-wrap hyphen left as 'sa- upādānāya'; Myanmar has saupādānāya; solid sa-upādānāya already stripped at extract"
        }
      }
    },
    {
      "id": "roman-amantesi-tena-dash-space",
      "when": {
        "match": "āmantesi–tena"
      },
      "do": {
        "replace": {
          "with": "āmantesi– tena",
          "remark": "Space after discourse en-dash; glued āmantesi–tena in 01Vin01/04Vin04/10Ma02 (spaced form already attested)"
        }
      }
    },
    {
      "id": "roman-addha-mahaddhana-dve-pada",
      "when": {
        "match": "aḍḍhāmahaddhanā"
      },
      "do": {
        "annotate": {
          "footnote": "aḍḍhā mahaddhanā dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-yopanati-dve-pada",
      "when": {
        "match": "Yopanāti"
      },
      "do": {
        "annotate": {
          "footnote": "yo panāti dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-tesam-yeva-niggahita-sandhi",
      "when": {
        "match": "tesaṃ yeva"
      },
      "do": {
        "annotate": {
          "footnote": "tesaṃyeva niggahītasandhi – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-tam-yeva-niggahita-sandhi",
      "when": {
        "match": "taṃ yeva"
      },
      "do": {
        "annotate": {
          "footnote": "taṃyeva niggahītasandhi – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-athakho-dve-nipata",
      "when": {
        "match": "athakho"
      },
      "do": {
        "annotate": {
          "footnote": "atha kho dve nipātā – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-athakhvetam-dve-pada",
      "when": {
        "match": "athakhvetaṃ"
      },
      "do": {
        "annotate": {
          "footnote": "atha khvetaṃ dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-tassa-kukkuccam-dve-pada",
      "when": {
        "match": "Tassakukkuccaṃ"
      },
      "do": {
        "annotate": {
          "footnote": "tassa kukkuccaṃ dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-panasa-coraka-samaso",
      "when": {
        "match": "Panasa corakā"
      },
      "do": {
        "annotate": {
          "footnote": "panasacorakā samāso – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-sinditva-bhinditva",
      "when": {
        "match": "sinditvā",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 51
          }
        ]
      },
      "do": {
        "replace": {
          "with": "bhinditvā",
          "remark": "Roman bh-; edition typo sinditvā in 01Vin01 p51 (bhinditvā in same passage, Burmese MS; tiṇakuṭikaṃ bhinditvā ×3)"
        }
      }
    },
    {
      "id": "roman-cira-civara-patho",
      "when": {
        "match": "cīrapiṇḍapātasenāsanagilānappaccayabhesajjaparikkhārā"
      },
      "do": {
        "annotate": {
          "footnote": "cīra- pāṭho, cīvara- – ม.พ.ป.",
          "soft_breaks": [
            "cīra",
            "piṇḍapāta",
            "senāsana",
            "gilānappaccaya",
            "bhesajja",
            "parikkhārā"
          ]
        }
      }
    },
    {
      "id": "roman-bhante-itthannama-comma",
      "when": {
        "match": "bhante itthannāmaṃ"
      },
      "do": {
        "replace": {
          "with": "bhante, itthannāmaṃ",
          "remark": "Roman comma after bhante; edition missing comma wherever bhante itthannāmaṃ (01Vin01, 04Vin04, 11Ma03)"
        }
      }
    },
    {
      "id": "roman-brūhi-hohi-comma",
      "when": {
        "match": "brūhi hohi"
      },
      "do": {
        "replace": {
          "with": "brūhi, hohi",
          "remark": "Roman comma after brūhi; edition missing comma wherever brūhi hohi (01Vin01)"
        }
      }
    },
    {
      "id": "roman-brūhi-hotha-comma",
      "when": {
        "match": "brūhi hotha"
      },
      "do": {
        "replace": {
          "with": "brūhi, hotha",
          "remark": "Roman comma after brūhi; edition missing comma wherever brūhi hotha (01Vin01)"
        }
      }
    },
    {
      "id": "roman-haneyyum-vati-dve-pada",
      "when": {
        "match": "Haneyyuṃvāti"
      },
      "do": {
        "annotate": {
          "footnote": "haneyyuṃ vāti dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-bandheyyum-vati-dve-pada",
      "when": {
        "match": "Bandheyyuṃvāti"
      },
      "do": {
        "annotate": {
          "footnote": "bandheyyuṃ vāti dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-pabbajeyyum-vati-dve-pada",
      "when": {
        "match": "Pabbājeyyuṃvāti"
      },
      "do": {
        "annotate": {
          "footnote": "pabbājeyyuṃ vāti dve padāni – ม.พ.ป."
        }
      }
    },
    {
      "id": "roman-parajikassati-long-a",
      "when": {
        "match": "pārājikassati"
      },
      "do": {
        "replace": {
          "with": "pārājikassāti",
          "remark": "Roman pārājikassa + iti (-ssā-); edition typo pārājikassati in 01Vin01 p85 (pārājikassāti already attested, e.g. p46, p75)"
        }
      }
    },
    {
      "id": "roman-teyyacitta-theyya",
      "when": {
        "match": "teyyacittā"
      },
      "do": {
        "replace": {
          "with": "theyyacittā",
          "remark": "Roman theyya- (th-); edition typo teyyacittā in 01Vin01 p77 (theyyacittā already attested, e.g. same formula p76, p80)"
        }
      }
    },
    {
      "id": "roman-tihakarehi-long-a",
      "when": {
        "match": "Tīhākarehi"
      },
      "do": {
        "replace": {
          "with": "Tīhākārehi",
          "remark": "Roman Tīhākā- (long ā); edition typo Tīhākarehi for Tīhākārehi in 01Vin01 p124 (Tīhākārehi already attested same page ×2 and 6 other volumes)"
        }
      }
    },
    {
      "id": "roman-samepajjim-samapajjim-long-a",
      "when": {
        "match": "samepajjiṃ"
      },
      "do": {
        "replace": {
          "with": "samāpajjiṃ",
          "remark": "Roman samā- (long ā); edition typo samepajjiṃ for samāpajjiṃ in 01Vin01 p125 p127 (samāpajjiṃ already attested)"
        }
      }
    },
    {
      "id": "roman-samepajji-samapajji-long-a",
      "when": {
        "match": "samepajji"
      },
      "do": {
        "replace": {
          "with": "samāpajji",
          "remark": "Roman samā- (long ā); edition typo samepajji for samāpajji in 01Vin01 p185 (samāpajji already attested)"
        }
      }
    },
    {
      "id": "roman-eva-mahamsu-join",
      "when": {
        "match": "eva māhaṃsu"
      },
      "do": {
        "replace": {
          "with": "evamāhaṃsu",
          "remark": "Roman false space; Myanmar has evamāhaṃsu; 01Vin01 p81 (joined form already attested)"
        }
      }
    },
    {
      "id": "roman-eva-maha-join",
      "when": {
        "match": "eva māha"
      },
      "do": {
        "replace": {
          "with": "evamāha",
          "remark": "Roman false space; Myanmar has evamāha; 01Vin01 p198 (joined form already attested, e.g. same formula p197)"
        }
      }
    },
    {
      "id": "roman-chambhitatta-join",
      "when": {
        "match": "chambhi tattaṃ"
      },
      "do": {
        "replace": {
          "with": "chambhitattaṃ",
          "remark": "Roman false space; Myanmar has chambhitattaṃ; 01Vin01 p87 (joined form already attested, e.g. same formula p87, 06Di01)"
        }
      }
    },
    {
      "id": "roman-evam-vutte-space",
      "when": {
        "match": "evaṃvutte"
      },
      "do": {
        "replace": {
          "with": "Evaṃ vutte",
          "remark": "Roman false join; Myanmar has evaṃ vutte; 01Vin01 p201 (Evaṃ vutte already attested corpus-wide)"
        }
      }
    },
    {
      "id": "roman-kim-taya-space",
      "when": {
        "match": "Kiṃtayā"
      },
      "do": {
        "replace": {
          "with": "Kiṃ tayā",
          "remark": "Roman glue; Myanmar has Kiṃ tayā; edition typo Kiṃtayā in 01Vin01 p86"
        }
      }
    },
    {
      "id": "roman-kuttam-upatthambhesi-space",
      "when": {
        "match": "kuṭṭaṃupatthambhesi"
      },
      "do": {
        "replace": {
          "with": "kuṭṭaṃ upatthambhesi",
          "remark": "Roman glue; Myanmar has kuṭṭaṃ upatthambhesi; 01Vin01 p82"
        }
      }
    },
    {
      "id": "roman-pamsukulasannissati-join",
      "when": {
        "match": "paṃ sukūlasaññissāti"
      },
      "do": {
        "replace": {
          "with": "paṃsukūlasaññissāti",
          "remark": "Roman false space; Myanmar has paṃsukūlasaññissāti; 01Vin01 p80 (joined form already attested)"
        }
      }
    },
    {
      "id": "roman-sasannayapare-join",
      "when": {
        "match": "sasaññā yapare"
      },
      "do": {
        "replace": {
          "with": "sasaññāyapare",
          "remark": "Roman false space; Myanmar has sasaññāyapare; 01Vin01 p69"
        }
      }
    },
    {
      "id": "roman-annataro-bhikkhuno-genitive",
      "when": {
        "match": "aññataro bhikkhuno"
      },
      "do": {
        "replace": {
          "with": "aññatarassa bhikkhuno",
          "remark": "Roman genitive; edition typo aññataro bhikkhuno in 01Vin01 p80 (aññatarassa bhikkhuno already attested, e.g. same formula p80 (105))"
        }
      }
    },
    {
      "id": "roman-tassa-kukkuccam-long-a",
      "when": {
        "match": "Tassa kukkuccaṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 84
          }
        ]
      },
      "do": {
        "replace": {
          "with": "Tassā kukkuccaṃ",
          "remark": "Roman Tassā- (feminine, nun); edition typo Tassa kukkuccaṃ in 01Vin01 p84 (146) (Tassā already attested same folio (145), p72, p112)"
        }
      }
    },
    {
      "id": "roman-nacchinna-long-a",
      "when": {
        "match": "nacchinnaṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 187,
            "order": 1200
          }
        ]
      },
      "do": {
        "replace": {
          "with": "nacchannaṃ",
          "remark": "Roman nacchannaṃ (not nacchinnaṃ); edition typo in 01Vin01 p187 o1200 (nacchannaṃ already attested same volume, e.g. p258/p301)"
        }
      }
    },
    {
      "id": "roman-sacchikata-maggo",
      "when": {
        "match": "sacchikatā",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 125,
            "order": 662
          }
        ]
      },
      "do": {
        "replace": {
          "with": "sacchikato",
          "remark": "Roman sacchikato (masc. Burmese MS); edition typo sacchikatā in 01Vin01 p125 o662 (sacchikatā correct elsewhere, e.g. p124 o657/o661)"
        }
      }
    },
    {
      "id": "roman-anapatti-bhikkhu-samghadisesassa",
      "when": {
        "match": "Anāpatti saṃghādisesassa",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 185,
            "order": 1182
          }
        ]
      },
      "do": {
        "replace": {
          "with": "Anāpatti bhikkhu saṃghādisesassa",
          "remark": "Edition missing bhikkhu in Anāpatti formula; 01Vin01 p185 o1182 (Burmese MS; parallel (5)–(7) same page have bhikkhu)"
        }
      }
    },
    {
      "id": "roman-gacchantim-acc",
      "when": {
        "match": "gacchantiṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 145,
            "order": 801
          },
          {
            "volume": "01Vin01",
            "page": 145,
            "order": 802
          }
        ]
      },
      "do": {
        "replace": {
          "with": "gacchantaṃ",
          "remark": "Roman gacchantaṃ; edition typo gacchantiṃ in 01Vin01 p145 orders 801 maṃsapiṇḍaṃ and 802 nicchaviṃ purisaṃ (Burmese MS; gacchantiṃ kept on feminine loci, including p145 order 800 maṃsapesiṃ and p147 nicchaviṃ itthiṃ)"
        }
      }
    },
    {
      "id": "roman-na-sambahula-comma",
      "when": {
        "match": "na sambahulā na ekapuggalo",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 153,
            "order": 848
          }
        ]
      },
      "do": {
        "replace": {
          "with": "na sambahulā, na ekapuggalo",
          "remark": "Edition missing comma after na sambahulā in 01Vin01 p153 (na sambahulā, na ekapuggalo already attested p283)"
        }
      }
    },
    {
      "id": "roman-kasmim-kismim",
      "when": {
        "match": "kasmiṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 197,
            "order": 1292
          }
        ]
      },
      "do": {
        "replace": {
          "with": "kismiṃ",
          "remark": "Roman kismiṃ (loc. kiṃ); edition typo kasmiṃ in 01Vin01 p197 o1292 (Kasmiṃ kept in 19Khu02 p186 gāthā)"
        }
      }
    },
    {
      "id": "roman-vayamati-phassa-na-ca",
      "when": {
        "match": "vāyamati phassaṃ",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 183,
            "order": 1164
          }
        ]
      },
      "do": {
        "replace": {
          "with": "vāyamati, na ca  phassaṃ",
          "remark": "Edition missing na ca; parallel 01Vin01 p183 o1163; loci skips other vāyamati phassaṃ glue on p181–183"
        }
      }
    },
    {
      "id": "roman-civara-pindapata-join-01vin01-195",
      "when": {
        "match": "cīvara piṇḍapāta senāsana gilānappaccaya bhesajjaparikkhārena",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 195,
            "order": 1279
          }
        ]
      },
      "do": {
        "replace": {
          "with": "cīvarapiṇḍapātasenāsanagilānappaccayabhesajjaparikkhārena",
          "remark": "Roman one compound (four requisites instrumental); edition line-split in 01Vin01 p195 order 1279 (same spaced form left in 16An02 p323, 17An03 p66)"
        }
      }
    },
    {
      "id": "roman-kalamakasi-pa-duplicate-kukkucca",
      "when": {
        "match": "kālamakāsi. Tassa kukkuccaṃ ahosi -pa- paripatitvā na kālamakāsi",
        "loci": [
          {
            "volume": "01Vin01",
            "page": 104,
            "order": 515
          }
        ]
      },
